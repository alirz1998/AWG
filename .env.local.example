# Diese Datei kopieren zu .env.local und mit deinen echten Werten füllen
# Werte findest du in Supabase: Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key

# Für den KI-Assistenten im Dashboard: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=dein-anthropic-api-key

# Für den Kalender-Abo-Link (/admin/kalender-abo): Supabase Dashboard ->
# Project Settings -> API -> "service_role" Secret. NIE ins Frontend
# einbauen, nur serverseitig verwendet.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key
